# Which provider powers the pipeline by default. One of: groq, openai, anthropic, gemini
DEFAULT_PROVIDER=groq

# --- API keys (only set the ones for providers you'll use) ---
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Web search fallback (optional) ---
TAVILY_API_KEY=

# --- Per-provider model overrides (optional; sensible defaults are set in code) ---
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-5-nano
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-2.5-flash

# --- Optional: use a different provider for specific pipeline roles ---
# e.g. run conflict resolution on a stronger model while keeping grading on Groq
# ROUTER_PROVIDER=
# GRADER_PROVIDER=
# CONFLICT_PROVIDER=
# GENERATOR_PROVIDER=
# HALLUCINATION_PROVIDER=

# --- Retrieval / pipeline knobs ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=4
SUFFICIENCY_THRESHOLD=2
MAX_REWRITE_ATTEMPTS=2
MAX_REGENERATIONS=2
FAITHFULNESS_THRESHOLD=0.8
